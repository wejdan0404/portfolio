---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/sections/Hero.astro";
import Chain from "../../components/sections/Chain.astro";
import SelectedWork from "../../components/sections/SelectedWork.astro";
import About from "../../components/sections/About.astro";
import Capabilities from "../../components/sections/Capabilities.astro";
import Contact from "../../components/sections/Contact.astro";
import { type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return [
    { params: { locale: "ar" } },
    { params: { locale: "en" } },
  ];
}

const locale = Astro.params.locale as Locale;

const title = locale === "ar"
  ? "وجدان — مصممة منتجات من جدة"
  : "Wejdan — Product designer, Jeddah";

const description = locale === "ar"
  ? "وجدان مصممة منتجات من جدة. تجربة مستخدم وأبحاث لسياق سعودي."
  : "Wejdan is a Jeddah-based product designer. UX and research for Saudi products.";
---

<Base locale={locale} title={title} description={description} path="">
  <Hero locale={locale} />
  <Chain locale={locale} />
  <SelectedWork locale={locale} />
  <About locale={locale} />
  <Capabilities locale={locale} />
  <Contact locale={locale} />
</Base>
