---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/sections/Hero.astro";
import Chain from "../../components/sections/Chain.astro";
import SelectedWork from "../../components/sections/SelectedWork.astro";
import About from "../../components/sections/About.astro";
import Capabilities from "../../components/sections/Capabilities.astro";
import Contact from "../../components/sections/Contact.astro";
import { type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return [
    { params: { locale: "ar" } },
    { params: { locale: "en" } },
  ];
}

const locale = Astro.params.locale as Locale;

const title = locale === "ar"
  ? "الرئيسية"
  : "Home";

const description = locale === "ar"
  ? "وجدان المالكي حاصلة على بكالوريوس تفاعل الإنسان مع الحاسب من جامعة أم القرى، وتهتم بتصميم UI/UX وأبحاث تجربة المستخدم وتصميم المنتجات والتفاعل بين الإنسان والذكاء الاصطناعي وتجربة العميل (CX)."
  : "Wejdan Almalki holds a Bachelor’s degree in Human-Computer Interaction (HCI) from Umm Al-Qura University. Her professional areas include UI/UX design, UX research, product design, human–AI interaction, and customer experience (CX).";
---

<Base locale={locale} title={title} description={description} path="">
  <Hero locale={locale} />
  <Chain locale={locale} />
  <SelectedWork locale={locale} />
  <About locale={locale} />
  <Capabilities locale={locale} />
  <Contact locale={locale} />
</Base>
