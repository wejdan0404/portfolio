---
import Base from "../../layouts/Base.astro";
import { type Locale, LOCALES, localePath } from "../../lib/i18n";
import { strings, pick } from "../../lib/strings";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l } }));
}
const locale = Astro.params.locale as Locale;

type Bi = { en: string; ar: string };
const t = (en: string, ar: string): Bi => ({ en, ar });

// Short bio — the "who" paragraph
const whoPara = t(
  "I'm Wejdan, an HCI graduate and UX/UI designer. I start by understanding the user and the problem before moving into design.",
  "أنا وجدان، خريجة تفاعل الإنسان والحاسب ومصممة تجربة مستخدم وواجهات. أبدأ بفهم المستخدم والمشكلة قبل ما أنتقل للتصميم.",
);

// Longer "practice" paragraph — from the brand positioning
const practicePara = t(
  "I use research and testing to guide design decisions, and I clearly label work that has not been tested. I choose methods to fit the question and document decisions so the team can build on them.",
  "أستخدم البحث والاختبار لتوجيه قرارات التصميم، وأوضح إذا كان المشروع ما اختُبر. أختار الأسلوب المناسب للسؤال، وأوثّق القرارات عشان الفريق يقدر يكمل عليها.",
);

// Secondary paragraphs — kept concise and non-redundant
const secondaryParas = [
  t(
    "I design in Arabic and English with equal rigor. I account for right-to-left layouts from the first component.",
    "أصمم بالعربي والإنجليزي من البداية، وأراعي اتجاه الكتابة في كل مكوّن.",
  ),
];

// Four principles — same as the home About section, kept in sync.
const principles = [
  {
    k: "01",
    en: "Research-grounded",
    ar: "البحث يوجّه التصميم",
    body: {
      en: "Every claim traces to a page. If the evidence isn't there, the page says so.",
      ar: "أربط القرارات بنتائج البحث، وأوضح إذا ما توفر دليل.",
    },
  },
  {
    k: "02",
    en: "Arabic held to standard",
    ar: "العربي بنفس الدقة",
    body: {
      en: "RTL is load-bearing from the first component — not a theme switch, not a translation.",
      ar: "أراعي اتجاه الكتابة من البداية، مو كخطوة أضيفها في النهاية.",
    },
  },
  {
    k: "03",
    en: "Systems before screens",
    ar: "الأنظمة قبل الشاشات",
    body: {
      en: "Tokens, components, and type scales come first. Screens come out of them.",
      ar: "أرتّب الألوان والخطوط والمكوّنات أول، عشان تكون الشاشات متناسقة وسهلة التطوير.",
    },
  },
  {
    k: "04",
    en: "Decoration serves clarity",
    ar: "الزينة لخدمة الوضوح",
    body: {
      en: "When in doubt, cut the ornament before cutting the signal.",
      ar: "كل عنصر في الواجهة لازم يساعد على وضوح الفكرة.",
    },
  },
];

const basedLine = t(
  "Based in Makkah / Jeddah. Open to remote work.",
  "مقرّي بين مكة وجدة. مستعدّة للعمل عن بُعد.",
);
---

<Base locale={locale} path="/about" title={pick(strings.about.pageTitle, locale)}>
  <section class="about-page">
    <div class="container-wide">
      <!-- Who -->
      <header class="about-hero">
        <span class="type-eyebrow">{pick(strings.about.pageTitle, locale)}</span>
        <h1 class="type-display-l about-h1">
          {locale === "ar" ? "عن وجدان." : "Briefly, me."}
        </h1>
        <p class="about-lede">{pick(whoPara, locale)}</p>
      </header>

      <!-- Practice -->
      <section class="about-practice" aria-label={locale === "ar" ? "طريقة الشغل" : "How I work"}>
        <h2 class="about-h2">
          {locale === "ar" ? "كيف أشتغل." : "How I work."}
        </h2>
        <p class="about-prose">{pick(practicePara, locale)}</p>
        {secondaryParas.map((p) => (
          <p class="about-prose">{pick(p, locale)}</p>
        ))}
      </section>

      <!-- Principles 2x2 -->
      <section class="about-principles" aria-label={locale === "ar" ? "المبادئ" : "Principles"}>
        <h2 class="about-h2">
          {locale === "ar" ? "مبادئي في العمل." : "What I work by."}
        </h2>
        <ul class="principles" role="list">
          {principles.map((p) => (
            <li class="principle">
              <span class="p-k">{p.k}</span>
              <h3 class="p-title">{locale === "ar" ? p.ar : p.en}</h3>
              <p class="p-body">{pick(p.body, locale)}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- CTAs -->
      <section class="about-ctas" aria-label={locale === "ar" ? "روابط" : "Next"}>
        <a href={localePath(locale, "services")} class="about-cta">
          <div class="cta-head">
            <span class="cta-k">01</span>
            <h3 class="cta-h">
              {locale === "ar" ? "وش أقدمه" : "What I offer"}
            </h3>
          </div>
          <p class="cta-sub">
            {locale === "ar"
              ? "ثلاث خدمات، ومعيار واحد: مخرجات واضحة وصادقة."
              : "Three lanes, one standard: honest output."}
          </p>
          <span class="cta-arrow mirror" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href={localePath(locale, "cv")} class="about-cta">
          <div class="cta-head">
            <span class="cta-k">02</span>
            <h3 class="cta-h">
              {locale === "ar" ? "السيرة الذاتية" : "View CV"}
            </h3>
          </div>
          <p class="cta-sub">
            {locale === "ar"
              ? "حمّلي سيرتي الذاتية بصيغة PDF."
              : "A shareable snapshot of studies and work."}
          </p>
          <span class="cta-arrow mirror" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      </section>

      <!-- Based-in line -->
      <p class="about-based">{pick(basedLine, locale)}</p>
    </div>
  </section>
</Base>

<style>
  .about-page { padding-block: clamp(2.5rem, 5vw, 4rem); }

  .about-hero { max-width: 820px; display: grid; gap: 1rem; margin-block-end: clamp(3rem, 6vw, 4.5rem); }
  .about-h1 { max-width: 20ch; margin-block-start: 0.5rem; }
  .about-lede {
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.6;
    max-width: 56ch;
  }
  html[lang="ar"] .about-lede { font-size: 1.15rem; line-height: 1.85; }

  .about-h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.2;
    margin-block-end: 1.25rem;
    max-width: 20ch;
  }
  html[lang="ar"] .about-h2 { letter-spacing: 0; line-height: 1.4; }

  .about-practice {
    max-width: 760px;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 4.5rem);
    border-block-start: 1px solid var(--border-subtle);
    margin-block-start: 1rem;
    display: grid;
    gap: 1rem;
  }
  .about-prose {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 62ch;
  }
  html[lang="ar"] .about-prose { font-size: 1.1rem; line-height: 1.85; }

  .about-principles {
    padding-block: clamp(2rem, 5vw, 4rem);
    border-block-start: 1px solid var(--border-subtle);
  }

  /* Principles 2x2 — identical pattern to the home AboutStrip */
  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .principles { grid-template-columns: 1fr 1fr; }
  }
  .principle {
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 170px;
  }
  .p-k {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--brand-primary);
    font-weight: 600;
  }
  html[lang="ar"] .p-k { letter-spacing: 0; font-size: 0.85rem; }
  .p-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  html[lang="ar"] .p-title { letter-spacing: 0; font-size: 1.2rem; }
  .p-body {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  html[lang="ar"] .p-body { font-size: 1rem; line-height: 1.75; }

  .about-ctas {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-block-start: 1px solid var(--border-subtle);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) { .about-ctas { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
  .about-cta {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.5rem 1.5rem;
    padding-inline-end: 3.5rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    border-radius: 16px;
    text-decoration: none;
    color: var(--text-primary);
    min-height: 128px;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .about-cta:hover { background: var(--surface-elevated); border-color: var(--border-default); transform: translateY(-1px); }
  .cta-head { display: inline-flex; align-items: center; gap: 0.6rem; }
  .cta-k {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-primary);
    font-weight: 600;
  }
  html[lang="ar"] .cta-k { letter-spacing: 0; text-transform: none; font-size: 0.85rem; }
  .cta-h {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  html[lang="ar"] .cta-h { letter-spacing: 0; font-size: 1.2rem; }
  .cta-sub {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 46ch;
  }
  html[lang="ar"] .cta-sub { font-size: 1rem; line-height: 1.75; }
  .cta-arrow {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 1.25rem;
    transform: translateY(-50%);
    color: var(--text-muted);
    transition: color 160ms ease;
    display: inline-flex;
  }
  .about-cta:hover .cta-arrow { color: var(--brand-primary); }

  .about-based {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: start;
  }
  html[lang="ar"] .about-based { font-size: 0.95rem; }
</style>
