---
import Base from "../../layouts/Base.astro";
import { type Locale, LOCALES } from "../../lib/i18n";
import { strings, pick } from "../../lib/strings";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l } }));
}
const locale = Astro.params.locale as Locale;

const EMAIL = "wejdan4458@gmail.com";

// Honest copy: no fake download button, no fake dates.
const headline = {
  en: "The current CV is being updated.",
  ar: "السيرة الذاتية قيد التحديث.",
};
const body = {
  en: "A fresh version is in progress. In the meantime, send a short note and I’ll share a tailored copy.",
  ar: "النسخة الجديدة قيد الإعداد. في هذه الأثناء، راسليني بسطر قصير وسأُرسل نسخة ملائمة.",
};
---

<Base locale={locale} path="/cv" title={pick(strings.cv.pageTitle, locale)}>
  <section class="cv-page">
    <div class="container-wide cv-inner">
      <span class="type-eyebrow">{pick(strings.cv.pageTitle, locale)}</span>
      <h1 class="cv-headline">{pick(headline, locale)}</h1>
      <p class="cv-body">{pick(body, locale)}</p>
      <p class="cv-contact">
        <!-- Mixed-direction content: isolate the email so bidi doesn't reorder it -->
        {locale === "ar" ? (
          <>
            راسليني على <a href={`mailto:${EMAIL}?subject=CV%20Request`} dir="ltr" class="cv-mail"><bdi>{EMAIL}</bdi></a> للحصول على نسخة.
          </>
        ) : (
          <>
            Email <a href={`mailto:${EMAIL}?subject=CV%20Request`} dir="ltr" class="cv-mail"><bdi>{EMAIL}</bdi></a> for a copy.
          </>
        )}
      </p>
    </div>
  </section>
</Base>

<style>
  .cv-page {
    padding-block: clamp(4rem, 10vw, 8rem);
    display: grid;
    place-items: start;
  }
  .cv-inner {
    max-width: 760px;
    text-align: start;
    position: relative;
    display: grid;
    gap: 1.25rem;
  }
  .cv-headline {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin-block-start: 0.75rem;
    max-width: 18ch;
  }
  html[lang="ar"] .cv-headline { letter-spacing: 0; line-height: 1.25; }
  .cv-body {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 56ch;
  }
  html[lang="ar"] .cv-body { font-size: 1.15rem; line-height: 1.85; }
  .cv-contact {
    margin-block-start: 0.5rem;
    padding: 1rem 1.25rem;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--brand-primary);
    border-radius: 0 10px 10px 0;
    font-size: 1.0625rem;
    color: var(--text-primary);
    max-width: 56ch;
    line-height: 1.6;
  }
  html[dir="rtl"] .cv-contact { border-radius: 10px 0 0 10px; }
  html[lang="ar"] .cv-contact { font-size: 1.15rem; line-height: 1.85; }
  .cv-mail {
    color: var(--brand-primary);
    text-decoration-color: color-mix(in oklab, currentColor 50%, transparent);
    font-weight: 500;
  }
  .cv-mail:hover { color: var(--action-hover); }
</style>
