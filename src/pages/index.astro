---
// Static redirect from `/` to a locale by Accept-Language approximation.
// The build emits a plain HTML page with meta refresh + a script, so GH Pages
// handles the root request without server middleware.
// Base path is resolved from import.meta.env so the redirect works correctly
// under both the GitHub Pages fallback (/portfolio/...) and the eventual
// custom-domain root (wejdan.info/...).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const arPath = `${base}/ar`;
const enPath = `${base}/en`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wejdan Almalki — Portfolio</title>
    <meta name="description" content="Loading portfolio…" />
    <!-- Canonical URL is the future wejdan.info root — not the GitHub Pages fallback. -->
    <link rel="canonical" href="https://wejdan.info/ar" />
    <meta http-equiv="refresh" content={`0; url=${arPath}`} />
    <script is:inline define:vars={{ arPath, enPath }}>
      (function () {
        try {
          var langs = (navigator.languages || [navigator.language || "ar"]).map(function (l) { return l.toLowerCase(); });
          var en = langs.some(function (l) { return l.startsWith("en"); });
          var ar = langs.some(function (l) { return l.startsWith("ar"); });
          var target = ar ? arPath : en ? enPath : arPath;
          window.location.replace(target);
        } catch (e) {
          window.location.replace(arPath);
        }
      })();
    </script>
  </head>
  <body>
    <p style="font-family:system-ui;padding:2rem;">
      <a href={arPath}>العربية</a> · <a href={enPath}>English</a>
    </p>
  </body>
</html>
