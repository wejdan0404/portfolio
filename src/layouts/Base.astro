---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/ibm-plex-sans-arabic/700.css";
import "../styles/globals.css";

import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import { type Locale, dirOf } from "../lib/i18n";
import { strings, pick } from "../lib/strings";

export interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
}

const { locale, title, description, path = "" } = Astro.props;
const dir = dirOf(locale);
const pageTitle = title
  ? `${title} · ${pick(strings.siteTitle, locale)}`
  : pick(strings.siteTitle, locale);
const pageDescription = description ?? pick(strings.siteDescription, locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://wejdan.info").toString();
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={new URL(`/ar${path}`, Astro.site ?? "https://wejdan.info").toString()} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site ?? "https://wejdan.info").toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/ar${path}`, Astro.site ?? "https://wejdan.info").toString()} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <!-- Pre-paint theme application -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("wj-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) { /* ignore */ }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      {locale === "ar" ? "تخطَّ إلى المحتوى" : "Skip to content"}
    </a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
