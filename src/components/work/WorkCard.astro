---
import type { CollectionEntry } from "astro:content";
import { type Locale, localePath, withBase } from "../../lib/i18n";
import { strings, pick } from "../../lib/strings";
import EvidenceDot from "./EvidenceDot.astro";
import DeviceFrame from "./DeviceFrame.astro";
import { W_MONOGRAM_PATH } from "../../lib/logo";

export interface Props {
  entry: CollectionEntry<"case-studies">;
  locale: Locale;
  variant?: "lead" | "row" | "small";
}

const { entry, locale, variant = "row" } = Astro.props;
/* The case-studies collection is owned by a different agent; tolerate missing
   fields rather than crash the home page when its schema shifts. */
const d = entry.data as any;
const href = localePath(locale, `work/${d.slug}`);
const title = pick(d.title, locale);
const sub = pick(d.sub, locale);

/* Poster screens: a curated set of phone-ratio captures for the card. */
const posterScreens: Array<{
  src: string;
  alt?: { en: string; ar: string };
  w?: number;
  h?: number;
}> = Array.isArray(d.posterScreens) ? d.posterScreens : [];

const isBrand = d.coverTreatment === "brand";
const canPoster = !isBrand && posterScreens.length >= 2;

/* Legacy single-image fallback (no poster screens, not brand). */
const firstImage = Array.isArray(d.images) && d.images.length > 0 ? d.images[0] : null;
const singleHero = !canPoster && !isBrand && firstImage ? firstImage : null;

/* Per-project tint. Fall back to the brand sky/violet. */
const tintLight: string = d.tint?.light ?? "#E7EFFB";
const tintDark: string = d.tint?.dark ?? "#1A2240";
const tintStyle = `--pt-light:${tintLight};--pt-dark:${tintDark};`;

/* Shorten the role line to its first clause for the chip. */
const roleFirst = d.role ? pick(d.role, locale).split(/[.·]/)[0].trim() : "";

/* First evidence row — a compact signal for the card. */
const rawEvidence = Array.isArray(d.evidence) && d.evidence.length > 0 ? d.evidence[0] : null;
const topEvidence = rawEvidence && typeof rawEvidence.value === "string" && rawEvidence.label
  ? rawEvidence
  : null;

const statusLabel = pick(strings.statusLabel[d.status as "tested" | "planned" | "early"], locale);
const year = typeof d.year === "string" ? d.year : "";
const teamSize = typeof d.teamSize === "number" ? d.teamSize : 0;

/* Case-insensitive glyph for the brand composition — in Arabic we use the Arabic first char. */
const glyph = ((locale === "ar" ? d.title.ar : d.title.en) || "").trim().slice(0, 1);

/* Pick how many screens to render in the composition for this variant. */
const screenCount = variant === "lead" ? Math.min(posterScreens.length, 4) : Math.min(posterScreens.length, 3);
const screens = posterScreens.slice(0, screenCount);
---

<a
  class={`wcard wcard-${variant} status-${d.status} ${canPoster ? "wcard-has-poster" : ""} ${isBrand ? "wcard-is-brand" : ""}`}
  href={href}
  aria-label={`${title} — ${sub}`}
  style={tintStyle}
  data-reveal
  data-tilt
>
  <div class="wcard-media">
    <div class="wcard-frame" aria-hidden={canPoster || singleHero ? undefined : "true"}>
      {canPoster ? (
        <div class={`poster poster-${variant} poster-count-${screens.length}`} aria-hidden="true">
          {/* Soft gradient background per project */}
          <span class="poster-bg"></span>
          <span class="poster-grain wj-texture" data-texture="paper-grain" aria-hidden="true"></span>
          {/* Decorative accents */}
          <span class="poster-star poster-star-a" aria-hidden="true"></span>
          <span class="poster-star poster-star-b" aria-hidden="true"></span>
          {/* Device-framed screens, stacked back to front */}
          <div class="poster-stack">
            {screens.map((s, i) => (
              <div class={`poster-slot poster-slot-${i}`}>
                <DeviceFrame
                  src={s.src}
                  alt={s.alt ? pick(s.alt, locale) : title}
                  width={s.w}
                  height={s.h}
                  size={variant === "lead" ? "md" : "sm"}
                  eager={variant === "lead" && i === 0}
                />
              </div>
            ))}
          </div>
        </div>
      ) : singleHero ? (
        <div class="poster poster-single" aria-hidden="true">
          <span class="poster-bg"></span>
          <span class="poster-grain wj-texture" data-texture="paper-grain" aria-hidden="true"></span>
          <div class="poster-single-wrap">
            <img
              src={singleHero.src.startsWith("http") ? singleHero.src : withBase(singleHero.src)}
              alt={singleHero.alt ? pick(singleHero.alt, locale) : title}
              width={singleHero.w ?? 1600}
              height={singleHero.h ?? 1200}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      ) : (
        <div class="brand-comp">
          <span class="bc-grad" aria-hidden="true"></span>
          <span class="bc-grain wj-texture" data-texture="soft-grain" aria-hidden="true"></span>
          <svg class="bc-w" viewBox="0 0 48 48" width="54%" height="54%" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={W_MONOGRAM_PATH}
                  fill="var(--logo-primary)"/>
          </svg>
          <span class="bc-displaytitle">{glyph === d.title.en.slice(0,1) ? d.title.en : d.title.ar}</span>
        </div>
      )}
      <span class={`wcard-status s-${d.status}`}>
        <EvidenceDot status={d.status} locale={locale} small={true} />
        <span class="sr-only">{statusLabel}</span>
      </span>
    </div>
  </div>

  <div class="wcard-body">
    {(year || teamSize) ? (
      <p class="wcard-eyebrow">
        {year ? <span>{year}</span> : null}
        {year && teamSize ? <span class="dotsep" aria-hidden="true">·</span> : null}
        {teamSize ? <span>{locale === "ar" ? `فريق من ${teamSize}` : `Team of ${teamSize}`}</span> : null}
      </p>
    ) : null}

    <h3 class="wcard-title">{title}</h3>
    <p class="wcard-sub">{sub}</p>

    {roleFirst && <span class="role-chip">{roleFirst}</span>}

    {topEvidence && variant === "lead" && (
      <p class="wcard-evidence">
        <span class="we-value numeric">{topEvidence.value}</span>
        <span class="we-label">{pick(topEvidence.label, locale)}</span>
      </p>
    )}

    <span class="wcard-cta">
      <span>{pick(strings.work.openCase, locale)}</span>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  .wcard {
    display: grid;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border-radius: 20px;
    isolation: isolate;
    position: relative;
    transition: transform 240ms cubic-bezier(.2,.7,.2,1);
  }
  .wcard:hover { transform: translateY(-3px); }
  .wcard:hover .wcard-cta span { color: var(--text-accent); }
  .wcard:hover .poster-stack { transform: translateY(-2px); }

  /* ---------- Media frame (shared) ---------- */
  .wcard-media {
    position: relative;
    width: 100%;
  }
  .wcard-frame {
    position: relative;
    border-radius: 18px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .wcard-lead .wcard-frame { aspect-ratio: 7 / 5; border-radius: 22px; }
  .wcard-small .wcard-frame { aspect-ratio: 4 / 3; border-radius: 16px; }

  /* ---------- Poster composition ---------- */
  .poster {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  /* § 06 Texture: the grain here is the Figma variant, applied as a mask by
     .wj-texture. Only the stacking context stays local. */
  .poster-grain, .bc-grain { z-index: 1; }
  .poster-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(140% 100% at 50% 0%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 92%, white 0%) 0%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 55%, white 0%) 42%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 20%, var(--surface-subtle)) 100%);
  }
  :global(:root[data-theme="dark"]) .poster-bg {
    background:
      radial-gradient(140% 110% at 50% 0%,
        color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 85%, black 0%) 0%,
        color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 55%, black 0%) 48%,
        color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 25%, var(--surface-default)) 100%);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .poster-bg {
      background:
        radial-gradient(140% 110% at 50% 0%,
          color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 85%, black 0%) 0%,
          color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 55%, black 0%) 48%,
          color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 25%, var(--surface-default)) 100%);
    }
  }

  /* Decorative star accents */
  .poster-star {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: var(--brand-primary);
    /* § 04 Sparks: the canonical four-point mark, masked so it keeps its
       own 48.06:54 proportions instead of being stretched square. */
    -webkit-mask-image: var(--wj-spark-four-point);
    mask-image: var(--wj-spark-four-point);
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center;  mask-position: center;
    -webkit-mask-size: contain;     mask-size: contain;
    opacity: 0.5;
  }
  :global(:root[data-theme="dark"]) .poster-star { background: var(--brand-secondary); opacity: 0.4; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .poster-star { background: var(--brand-secondary); opacity: 0.4; }
  }
  .poster-star-a { width: 14px; height: 14px; inset-block-start: 10%; inset-inline-end: 8%; }
  .poster-star-b { width: 7px; height: 7px; inset-block-end: 12%; inset-inline-start: 10%; opacity: 0.4; }
  .wcard-lead .poster-star-a { width: 20px; height: 20px; }

  /* Device-frame stack */
  .poster-stack {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    transition: transform 320ms cubic-bezier(.2,.7,.2,1);
  }
  .poster-slot {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform-origin: center;
    will-change: transform;
  }
  .poster-slot :global(.dframe) { width: 100%; height: 100%; }

  /* ---- Lead variant: up to 4 phones in a fan ---- */
  /* The center phone is the hero (slot-0). Slots behind are smaller and tilted. */
  .poster-lead .poster-slot-0 {
    width: 27%; aspect-ratio: 9/19.5;
    transform: translate(-50%, -50%) rotate(-2deg);
    z-index: 7;
  }
  .poster-lead .poster-slot-1 {
    width: 25%; aspect-ratio: 9/19.5;
    transform: translate(-150%, -46%) rotate(-11deg);
    z-index: 6;
  }
  .poster-lead .poster-slot-2 {
    width: 25%; aspect-ratio: 9/19.5;
    transform: translate(50%, -46%) rotate(11deg);
    z-index: 6;
  }
  .poster-lead .poster-slot-3 {
    width: 18%; aspect-ratio: 9/19.5;
    transform: translate(-150%, -42%) rotate(-14deg);
    z-index: 5;
    opacity: 0.9;
  }
  html[dir="rtl"] .poster-lead .poster-slot-1 { transform: translate(50%, -46%) rotate(11deg); z-index: 6; }
  html[dir="rtl"] .poster-lead .poster-slot-2 { transform: translate(-150%, -46%) rotate(-11deg); z-index: 6; }
  html[dir="rtl"] .poster-lead .poster-slot-3 { transform: translate(50%, -42%) rotate(14deg); z-index: 5; }

  /* ---- Row variant: 2 phones leaning together, a 3rd peeking in back ---- */
  .poster-row .poster-slot-0 {
    width: 32%; aspect-ratio: 9/19.5;
    transform: translate(-72%, -50%) rotate(-6deg);
    z-index: 7;
  }
  .poster-row .poster-slot-1 {
    width: 32%; aspect-ratio: 9/19.5;
    transform: translate(-28%, -48%) rotate(6deg);
    z-index: 6;
  }
  .poster-row .poster-slot-2 {
    width: 26%; aspect-ratio: 9/19.5;
    transform: translate(-158%, -42%) rotate(-16deg);
    z-index: 5;
    opacity: 0.92;
  }
  html[dir="rtl"] .poster-row .poster-slot-0 { transform: translate(-28%, -50%) rotate(6deg); }
  html[dir="rtl"] .poster-row .poster-slot-1 { transform: translate(-72%, -48%) rotate(-6deg); }
  html[dir="rtl"] .poster-row .poster-slot-2 { transform: translate(58%, -42%) rotate(16deg); }

  /* ---- Small variant: compact 2-phone composition ---- */
  .poster-small .poster-slot-0 {
    width: 32%; aspect-ratio: 9/19.5;
    transform: translate(-72%, -48%) rotate(-6deg);
    z-index: 5;
  }
  .poster-small .poster-slot-1 {
    width: 32%; aspect-ratio: 9/19.5;
    transform: translate(-28%, -48%) rotate(6deg);
    z-index: 4;
  }
  html[dir="rtl"] .poster-small .poster-slot-0 { transform: translate(-28%, -48%) rotate(6deg); }
  html[dir="rtl"] .poster-small .poster-slot-1 { transform: translate(-72%, -48%) rotate(-6deg); }

  /* Single-image poster fallback */
  .poster-single-wrap {
    position: absolute;
    inset: 10% 10%;
    z-index: 3;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 18px 40px -22px rgba(14,18,28,0.3);
    background: var(--surface-elevated);
  }
  .poster-single-wrap img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }

  /* ---- Mobile: collapse overlap so screens stay legible ---- */
  @media (max-width: 760px) {
    .poster-slot { transform-origin: center; }
    .poster-lead .poster-slot-0,
    .poster-row .poster-slot-0,
    .poster-small .poster-slot-0 {
      width: 42%;
      transform: translate(-82%, -50%) rotate(-4deg);
    }
    .poster-lead .poster-slot-1,
    .poster-row .poster-slot-1,
    .poster-small .poster-slot-1 {
      width: 42%;
      transform: translate(-18%, -50%) rotate(4deg);
    }
    .poster-lead .poster-slot-2,
    .poster-row .poster-slot-2 { display: none; }
    .poster-lead .poster-slot-3 { display: none; }
    html[dir="rtl"] .poster-lead .poster-slot-0,
    html[dir="rtl"] .poster-row .poster-slot-0,
    html[dir="rtl"] .poster-small .poster-slot-0 {
      transform: translate(-18%, -50%) rotate(4deg);
    }
    html[dir="rtl"] .poster-lead .poster-slot-1,
    html[dir="rtl"] .poster-row .poster-slot-1,
    html[dir="rtl"] .poster-small .poster-slot-1 {
      transform: translate(-82%, -50%) rotate(-4deg);
    }
  }

  /* ---- Brand composition (WRAF, Pet Care) — upgraded ---- */
  .brand-comp {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .bc-grad {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 100% at 50% 0%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 90%, white) 0%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 60%, white) 50%,
        color-mix(in oklab, var(--pt-light, var(--brand-secondary)) 25%, var(--surface-elevated)) 100%);
  }
  :global(:root[data-theme="dark"]) .bc-grad {
    background:
      radial-gradient(120% 100% at 50% 0%,
        color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 70%, var(--brand-primary)) 0%,
        color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 70%, black) 50%,
        var(--surface-dark) 100%);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .bc-grad {
      background:
        radial-gradient(120% 100% at 50% 0%,
          color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 70%, var(--brand-primary)) 0%,
          color-mix(in oklab, var(--pt-dark, var(--brand-primary)) 70%, black) 50%,
          var(--surface-dark) 100%);
    }
  }
  .bc-w {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -58%);
    z-index: 2;
    opacity: 0.96;
  }
  html[dir="rtl"] .bc-w { transform: translate(50%, -58%); }
  .bc-displaytitle {
    position: absolute;
    inset-block-end: 1.1rem;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    z-index: 4;
    font-size: clamp(0.75rem, 1.1vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--text-primary);
    opacity: 0.78;
    white-space: nowrap;
  }
  html[dir="rtl"] .bc-displaytitle { transform: translateX(50%); letter-spacing: 0; text-transform: none; }
  :global(:root[data-theme="dark"]) .bc-displaytitle { color: #fff; opacity: 0.85; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .bc-displaytitle { color: #fff; opacity: 0.85; }
  }

  /* Status badge: bottom-left */
  .wcard-status {
    position: absolute;
    inset-block-end: 10px;
    inset-inline-start: 10px;
    z-index: 10;
    background: color-mix(in oklab, var(--surface-default) 92%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    line-height: 1;
  }

  /* ---------- Body ---------- */
  .wcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: 0.25rem 0.5rem;
  }
  .wcard-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin: 0;
  }
  html[lang="ar"] .wcard-eyebrow { font-size: 0.9375rem; letter-spacing: 0; }
  .dotsep { opacity: 0.6; }

  .wcard-title {
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0;
  }
  html[lang="ar"] .wcard-title { letter-spacing: 0; line-height: 1.35; }

  .wcard-lead .wcard-title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
  }
  .wcard-small .wcard-title {
    font-size: 1.125rem;
  }

  .wcard-sub {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 54ch;
    margin: 0;
    text-wrap: pretty;
  }
  html[lang="ar"] .wcard-sub { font-size: 1rem; line-height: 1.8; }
  .wcard-lead .wcard-sub { font-size: 1.0625rem; }

  .role-chip {
    align-self: flex-start;
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
    max-width: 100%;
  }
  html[lang="ar"] .role-chip { font-size: 0.9rem; }

  .wcard-evidence {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-block-start: 0.25rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .we-value {
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: lining-nums tabular-nums;
    font-size: 1.0625rem;
  }

  .wcard-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.9375rem;
    margin-block-start: 0.4rem;
  }
  .wcard-cta span:first-child {
    border-block-end: 1px solid currentColor;
    padding-block-end: 2px;
    transition: color 160ms ease;
  }

  /* ---------- Variants ---------- */
  .wcard-lead {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .wcard-lead {
      grid-template-columns: 7fr 5fr;
      gap: 2rem;
      align-items: center;
    }
    .wcard-lead .wcard-body { padding-inline-end: 1rem; }
  }

  .wcard-row { grid-template-columns: 1fr; }
  @media (min-width: 900px) {
    .wcard-row { grid-template-columns: 1fr 1fr; align-items: center; gap: 1.5rem; }
  }

  .wcard-small { grid-template-columns: 1fr; }
  .wcard-small .wcard-cta { font-size: 0.875rem; }
  .wcard-small .role-chip { font-size: 0.75rem; padding: 0.2rem 0.5rem; }

  /* Reduced-motion / focus */
  @media (prefers-reduced-motion: reduce) {
    .wcard, .poster-stack { transition: none; }
  }
  .wcard:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }
</style>
