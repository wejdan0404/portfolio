---
import { type Locale, localePath } from "../../lib/i18n";
import { W_MONOGRAM_PATH } from "../../lib/logo";
export interface Props {
  locale: Locale;
  size?: number;
  withWordmark?: boolean;
}
const { locale, size = 32, withWordmark = false } = Astro.props;
---

<a
  href={localePath(locale)}
  class="group inline-flex items-center gap-3"
  style="min-height:44px"
  aria-label={locale === "ar" ? "الذهاب إلى الصفحة الرئيسية" : "Go to home"}
>
  <span class="site-logo-mark relative inline-flex" style={`width:${size}px;height:${size}px;`}>
    <svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" style="display:block;">
      <path fill-rule="evenodd" clip-rule="evenodd" d={W_MONOGRAM_PATH}
            fill="var(--logo-primary)"/>
    </svg>
  </span>
  {withWordmark && (
    <span class="font-semibold tracking-tight" style="color: var(--text-primary); font-size: 1.0625rem;">
      {locale === "ar" ? "وجدان" : "Wejdan"}
    </span>
  )}
</a>
