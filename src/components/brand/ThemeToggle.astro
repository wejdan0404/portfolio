---
import { type Locale } from "../../lib/i18n";
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const label = locale === "ar" ? "تبديل السمة" : "Toggle theme";
---

<button
  type="button"
  class="theme-toggle"
  aria-label={label}
  data-theme-toggle
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="sun" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="moon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .theme-toggle:hover {
    background: var(--surface-subtle);
    border-color: var(--border-default);
  }
  .theme-toggle .moon { display: none; }
  :root[data-theme="dark"] .theme-toggle .sun { display: none; }
  :root[data-theme="dark"] .theme-toggle .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle .sun { display: none; }
    :root:not([data-theme="light"]) .theme-toggle .moon { display: block; }
  }
</style>

<script is:inline>
  (function () {
    // This component renders twice per page (header + mobile menu) and Astro
    // emits `is:inline` scripts once per instance, so without this guard the
    // document listener is bound twice and each click toggles twice — landing
    // back on the theme it started from. ClientRouter re-runs the script on
    // every navigation, so the guard has to live on `window`, not in closure.
    if (window.__wjThemeBound) return;
    window.__wjThemeBound = true;
    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-theme-toggle]");
      if (!btn) return;
      var current = document.documentElement.dataset.theme;
      if (!current) {
        current = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("wj-theme", next); } catch (err) {}
      if (window.__wjThemeColor) window.__wjThemeColor(next);
    });
  })();
</script>
