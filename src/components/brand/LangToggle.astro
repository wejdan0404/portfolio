---
import { type Locale, otherLocale, switchLocaleFromPath } from "../../lib/i18n";
export interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const other = otherLocale(locale);
const otherLabel = other === "ar" ? "العربية" : "English";
const current = `/${locale}${path.startsWith("/") ? path : "/" + path}`.replace(/\/+$/, "") || `/${locale}`;
const target = switchLocaleFromPath(current, other);
---
<a href={target} class="lang-toggle" hreflang={other} aria-label={other === "ar" ? "التبديل إلى العربية" : "Switch to English"}>
  <span>{otherLabel}</span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background 160ms ease, border-color 160ms ease;
    white-space: nowrap;
  }
  .lang-toggle:hover {
    background: var(--surface-subtle);
    border-color: var(--border-default);
  }
</style>
