---
import { type Locale, localePath } from "../../lib/i18n";
import { W_MONOGRAM_PATH } from "../../lib/logo";

export interface Props { locale: Locale; }
const { locale } = Astro.props;

/* Source: /home/claude/brand/source-copy.md — Page 01, Page 27.
   Owner spec: IBM Plex Sans SemiBold (not Serif), max -0.015em on Latin,
   zero letter-spacing on Arabic, no text-wrap balance on hero, two block spans,
   explicit font-size clamp that works down to 320px. */
const copy = {
  kicker: locale === "ar"
    ? "وجدان المالكي · HCI & UI/UX"
    : "Wejdan Almalki · HCI & UI/UX",
  lineA: locale === "ar" ? "مصممة تجربة مستخدم وواجهات." : "UI & UX designer.",
  lineB: locale === "ar" ? "أفهم احتياج المستخدم قبل ما أصمم له." : "I study the user before I design for them.",
  lede: locale === "ar"
    ? "حاصلة على بكالوريوس تفاعل الإنسان مع الحاسب من جامعة أم القرى. أصمم التطبيقات والمواقع، وأختبرها مع المستخدمين قبل إطلاقها."
    : "I hold a Bachelor’s degree in Human-Computer Interaction (HCI) from Umm Al-Qura University. I design apps and websites and test them with users before launch.",
  ctaPrimary: locale === "ar" ? "عرض المشاريع" : "View case studies",
  ctaSecondary: locale === "ar" ? "السيرة الذاتية" : "View CV",
  ctaTertiary: locale === "ar" ? "الخدمات" : "Services",
  visualLabel: locale === "ar" ? "علامة وجدان" : "Wejdan monogram",
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker"><span>{copy.kicker}</span></p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line hero-line-a">{copy.lineA}</span>
        <span class="hero-line hero-line-b">{copy.lineB}</span>
      </h1>
      <p class="hero-lede">{copy.lede}</p>
      <div class="hero-actions">
        <a href={localePath(locale, "work")} class="btn btn-primary">
          <span>{copy.ctaPrimary}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={localePath(locale, "cv")} class="btn btn-ghost">
          {copy.ctaSecondary}
        </a>
        <a href={localePath(locale, "services")} class="hero-link">
          {copy.ctaTertiary}
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <aside class="hero-visual" aria-label={copy.visualLabel}>
      <div class="panel">
        <!-- § 07 Depth and light: "One signal is enough." One glow orb,
             in the one composition the density ladder allows it. -->
        <span class="panel-gradient" aria-hidden="true"></span>
        <span class="panel-glow wj-glow" aria-hidden="true"></span>
        <span class="panel-grain wj-texture" data-texture="soft-grain" aria-hidden="true"></span>
        <svg class="panel-w" viewBox="0 0 48 48" width="60%" height="60%" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d={W_MONOGRAM_PATH}
                fill="var(--logo-primary)"/>
        </svg>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 5vw, 76px);
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.45fr 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  /* Below the two-column breakpoint the W panel is pure decoration and costs
     ~200px of scroll before any real content. Drop it instead of shrinking it
     further — the mark is already in the header. */
  @media (max-width: 959px) {
    .hero-visual { display: none; }
  }

  .hero-copy > * + * { margin-block-start: 1rem; }

  .hero-kicker {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0;
    text-wrap: pretty;
    max-width: 60ch;
  }
  html[lang="ar"] .hero-kicker { font-size: 0.9375rem; letter-spacing: 0; }

  /* Hero headline — IBM Plex Sans SemiBold, no text-wrap balance.
     Explicit clamp so it works from 320px up. */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    /* Capped at 44px: the headline is two full sentences, so a display size
       that works for 3 words turns this into a wall. */
    font-size: clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--text-primary);
    margin: 0;
    min-height: 1lh;
    max-width: 18ch;
  }
  html[lang="ar"] .hero-title {
    font-family: var(--font-arabic);
    letter-spacing: 0;
    line-height: 1.45;
    /* em, not ch. The ch unit is the advance of "0", and that differs 6.7%
       between IBM Plex Sans Arabic and thmanyah sans — enough to change the
       headline from three lines to two for a visitor who has thmanyah
       installed. 13.2em is what 22ch resolves to in Plex, so both wrap the
       same. Body copy still uses ch; a few percent there only reflows a
       paragraph, it does not change a headline's shape. */
    max-width: 13.2em;
  }

  .hero-line { display: block; min-height: 1lh; }
  /* Role line sits one step down and lighter — it labels, the second line claims. */
  .hero-line-a {
    color: var(--text-accent);
    font-size: 0.72em;
    font-weight: 500;
    letter-spacing: 0;
    margin-block-end: 0.35em;
  }
  .hero-line-b { color: var(--text-primary); }

  .hero-lede {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }
  html[lang="ar"] .hero-lede { line-height: 1.85; max-width: 50ch; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-block-start: 1.75rem;
  }
  /* Keep the two buttons paired and let only the text link drop below on
     narrow screens, instead of a lone orphan button on its own row. */
  @media (max-width: 420px) {
    .hero-actions { gap: 0.625rem 0.75rem; }
    .hero-actions .btn { flex: 1 1 auto; justify-content: center; }
    /* Full-width row so it drops below the buttons, but the underline
       hugs the text instead of running the whole row. */
    .hero-actions .hero-link {
      flex-basis: 100%;
      border-block-end: 0;
      align-self: start;
    }
    .hero-actions .hero-link > :first-child {
      border-block-end: 1px solid currentColor;
      padding-block-end: 2px;
    }
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding-block: 0.75rem;
    min-height: 44px;
    border-block-end: 1px solid currentColor;
    line-height: 1.2;
  }
  .hero-link:hover { color: var(--text-accent); }

  /* Hero visual — 20:21 soft brand panel with sky-to-white gradient,
     centred W at ~60%, three subtle star accents. */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    margin-inline-start: auto;
    margin-inline-end: 0;
  }
  @media (max-width: 959px) {
    .hero-visual {
      max-width: 200px;
      margin-inline-start: 0;
      margin-inline-end: auto;
    }
  }
  @media (max-width: 480px) {
    .hero-visual { max-width: 148px; }
  }
  .panel {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  /* The field is the canonical brand gradient from § 07; the light on top of
     it is one glow orb, and the surface carries one texture. Three layers,
     one of each kind — "stacked textures" and a second light source are both
     out by the rules. */
  .panel-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* A quiet lift off the panel surface, so the glow above it has something
       to sit on. The canonical brand gradient is not used here: it ends on
       pale sky, which leaves the mark with nothing to hold against. */
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--glow-accent) 16%, var(--surface-elevated)) 0%,
      var(--surface-elevated) 100%
    );
  }
  .panel-glow {
    --wj-glow-size: clamp(190px, 24vw, 330px);
    --wj-glow-opacity: 0.85;
    inset-block-start: -12%;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }
  /* `html[...]` and not a bare `[dir="rtl"]`: Astro scopes the ancestor in a
     bare attribute selector to this component too, and <html> never carries a
     component scope, so the rule would silently never match. */
  html[dir="rtl"] .panel-glow { transform: translateX(50%); }
  .panel-grain { z-index: 1; opacity: 0.9; }
  .panel-w {
    position: relative;
    z-index: 1;
    display: block;
  }
</style>
