---
import { type Locale, localePath } from "../../lib/i18n";

export interface Props { locale: Locale; }
const { locale } = Astro.props;

/* Source: /home/claude/brand/source-copy.md — Page 01, Page 27.
   Owner spec: IBM Plex Sans SemiBold (not Serif), max -0.015em on Latin,
   zero letter-spacing on Arabic, no text-wrap balance on hero, two block spans,
   explicit font-size clamp that works down to 320px. */
const copy = {
  kicker: locale === "ar"
    ? "وجدان · من جدة"
    : "Wejdan · Jeddah",
  lineA: locale === "ar" ? "مصممة واجهات وتجربة مستخدم." : "UI & UX designer.",
  lineB: locale === "ar" ? "أدرس المستخدم قبل ما أصمم له." : "I study the user before I design for them.",
  lede: locale === "ar"
    ? "خريجة HCI من جدة. أشتغل على تطبيقات ومواقع، وأختبرها مع المستخدم قبل ما تطلع."
    : "HCI graduate from Jeddah. I work on apps and websites, and test them with the user before they ship.",
  ctaPrimary: locale === "ar" ? "عرض المشاريع" : "View case studies",
  ctaSecondary: locale === "ar" ? "السيرة الذاتية" : "View CV",
  ctaTertiary: locale === "ar" ? "الخدمات" : "Services",
  visualLabel: locale === "ar" ? "علامة وجدان" : "Wejdan monogram",
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker"><span>{copy.kicker}</span></p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line hero-line-a">{copy.lineA}</span>
        <span class="hero-line hero-line-b">{copy.lineB}</span>
      </h1>
      <p class="hero-lede">{copy.lede}</p>
      <div class="hero-actions">
        <a href={localePath(locale, "work")} class="btn btn-primary">
          <span>{copy.ctaPrimary}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={localePath(locale, "cv")} class="btn btn-ghost">
          {copy.ctaSecondary}
        </a>
        <a href={localePath(locale, "services")} class="hero-link">
          {copy.ctaTertiary}
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <aside class="hero-visual" aria-label={copy.visualLabel}>
      <div class="panel">
        <span class="panel-gradient" aria-hidden="true"></span>
        <svg class="panel-w" viewBox="0 0 48 48" width="60%" height="60%" aria-hidden="true">
          <path d="M4.8 10.5 L11.9 36.5 L17.8 36.5 L24 18.1 L30.2 36.5 L36.1 36.5 L43.2 10.5 L37.4 10.5 L32.6 29.9 L26.5 11 L21.5 11 L15.4 29.9 L10.6 10.5 Z"
                fill="var(--logo-primary)"/>
        </svg>
        <span class="panel-star panel-star-1" aria-hidden="true"></span>
        <span class="panel-star panel-star-2" aria-hidden="true"></span>
        <span class="panel-star panel-star-3" aria-hidden="true"></span>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 5vw, 76px);
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.45fr 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .hero-copy > * + * { margin-block-start: 1rem; }

  .hero-kicker {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0;
    text-wrap: pretty;
    max-width: 60ch;
  }
  html[lang="ar"] .hero-kicker { font-size: 0.9375rem; letter-spacing: 0; }

  /* Hero headline — IBM Plex Sans SemiBold, no text-wrap balance.
     Explicit clamp so it works from 320px up. */
  .hero-title {
    font-family: "IBM Plex Sans", "IBM Plex Sans Arabic", system-ui, sans-serif;
    font-weight: 600;
    /* Capped at 44px: the headline is two full sentences, so a display size
       that works for 3 words turns this into a wall. */
    font-size: clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--text-primary);
    margin: 0;
    min-height: 1lh;
    max-width: 18ch;
  }
  html[lang="ar"] .hero-title {
    font-family: "IBM Plex Sans Arabic", "IBM Plex Sans", system-ui, sans-serif;
    letter-spacing: 0;
    line-height: 1.45;
    max-width: 22ch;
  }

  .hero-line { display: block; min-height: 1lh; }
  /* Role line sits one step down and lighter — it labels, the second line claims. */
  .hero-line-a {
    color: var(--text-accent);
    font-size: 0.72em;
    font-weight: 500;
    letter-spacing: 0;
    margin-block-end: 0.35em;
  }
  .hero-line-b { color: var(--text-primary); }

  .hero-lede {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }
  html[lang="ar"] .hero-lede { line-height: 1.85; max-width: 50ch; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-block-start: 1.75rem;
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding-block: 0.75rem;
    min-height: 44px;
    border-block-end: 1px solid currentColor;
    line-height: 1.2;
  }
  .hero-link:hover { color: var(--text-accent); }

  /* Hero visual — 20:21 soft brand panel with sky-to-white gradient,
     centred W at ~60%, three subtle star accents. */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    margin-inline-start: auto;
    margin-inline-end: 0;
  }
  @media (max-width: 959px) {
    .hero-visual {
      max-width: 200px;
      margin-inline-start: 0;
      margin-inline-end: auto;
    }
  }
  @media (max-width: 480px) {
    .hero-visual { max-width: 148px; }
  }
  .panel {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .panel-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 10%,
        color-mix(in oklab, var(--brand-secondary) 65%, transparent) 0%,
        color-mix(in oklab, var(--brand-secondary) 20%, transparent) 40%,
        transparent 72%),
      linear-gradient(180deg,
        color-mix(in oklab, var(--brand-secondary) 22%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 100%);
    z-index: 0;
    pointer-events: none;
  }
  .panel-w {
    position: relative;
    z-index: 1;
    display: block;
  }
  .panel-star {
    position: absolute;
    background: var(--brand-primary);
    clip-path: polygon(50% 0%, 55% 45%, 100% 50%, 55% 55%, 50% 100%, 45% 55%, 0% 50%, 45% 45%);
    z-index: 2;
  }
  .panel-star-1 {
    width: 12px; height: 12px;
    inset-block-start: 12%; inset-inline-end: 14%;
    opacity: 0.9;
  }
  .panel-star-2 {
    width: 8px; height: 8px;
    inset-block-end: 20%; inset-inline-start: 12%;
    opacity: 0.6;
  }
  .panel-star-3 {
    width: 6px; height: 6px;
    inset-block-end: 32%; inset-inline-end: 22%;
    opacity: 0.45;
  }
</style>
