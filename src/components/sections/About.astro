---
import { type Locale, localePath } from "../../lib/i18n";
import { W_MONOGRAM_PATH } from "../../lib/logo";

export interface Props { locale: Locale; }
const { locale } = Astro.props;

/* Source: /home/claude/brand/source-copy.md — Page 01, four principles each
   tied to an element of the W mark (letter · three stars · open arc · open curve).
   Essence line used as headline. */

type Mark = "letter" | "stars" | "arc" | "curve";
type Principle = {
  mark: Mark;
  title_en: string;
  title_ar: string;
  body_en: string;
  body_ar: string;
};

const principles: Principle[] = [
  {
    mark: "letter",
    title_en: "Starts with the user",
    title_ar: "تبدأ من المستخدم",
    body_en: "Research starts with the person using the product, not with the screen.",
    body_ar: "يبدأ البحث من المستخدم، لا من الشاشة.",
  },
  {
    mark: "stars",
    title_en: "Evidence, not opinion",
    title_ar: "دليل، لا رأي",
    body_en: "Findings carry their source; a claim without evidence stays out.",
    body_ar: "تحمل النتائجُ مصدرها؛ وما لا دليلَ له يبقى خارج العمل.",
  },
  {
    mark: "arc",
    title_en: "A system that stays open",
    title_ar: "نظامٌ يبقى مفتوحًا",
    body_en: "The product never closes on its user: clear exits, reversible steps, visible state.",
    body_ar: "لا يُغلق المنتجُ على المستخدم: مخارج واضحة، وخطوات قابلة للتراجع، وحالة ظاهرة.",
  },
  {
    mark: "curve",
    title_en: "Continuity after handover",
    title_ar: "استمراريةٌ بعد التسليم",
    body_en: "Decisions are documented so the next person can build on them.",
    body_ar: "تُوثَّق القرارات ليُكمل عليها من يأتي بعد.",
  },
];

const headlineEn = "How I work.";
const headlineAr = "كيف أشتغل.";
const eyebrowEn = "Approach";
const eyebrowAr = "الطريقة";
const moreEn = "More on the approach";
const moreAr = "تفاصيل أكثر عن الطريقة";
---

<section class="about" aria-labelledby="about-title">
  <div class="container-wide">
    <header class="about-head">
      <span class="type-eyebrow">{locale === "ar" ? eyebrowAr : eyebrowEn}</span>
      <h2 id="about-title" class="about-headline">
        {locale === "ar" ? headlineAr : headlineEn}
      </h2>
    </header>

    <ul class="princ-grid" role="list">
      {principles.map((p, i) => (
        <li class="princ" data-reveal data-reveal-delay={i + 1}>
          <div class="princ-mark" aria-hidden="true">
            {p.mark === "letter" && (
              <svg viewBox="0 0 48 48" width="24" height="24">
                {/* CLAUDE.md §2: the W mark renders only in Ink 900 or White —
                    never in an accent colour, so it does not take the chip's
                    brand-primary currentColor like the three diagram icons do. */}
                <path fill-rule="evenodd" clip-rule="evenodd" d={W_MONOGRAM_PATH}
                      fill="var(--logo-primary)"/>
              </svg>
            )}
            <!-- § 04 Sparks: the canonical four-point mark, three of them. The
                 Low quantity rule caps a composition at one or two; this is the
                 icon for the evidence principle, where three is the point. -->
            {p.mark === "stars" && (
              <svg viewBox="0 0 48 24" width="40" height="20">
                <g fill="currentColor">
                  <path d="M8.5 4.7C9.02 8.93 11.23 11.42 15.0 12.0C11.23 12.58 9.02 15.07 8.5 19.3C7.98 15.07 5.77 12.58 2.0 12.0C5.77 11.42 7.98 8.93 8.5 4.7Z"/>
                  <path d="M24.0 7.22C24.34 9.99 25.79 11.62 28.25 12.0C25.79 12.38 24.34 14.01 24.0 16.78C23.66 14.01 22.21 12.38 19.75 12.0C22.21 11.62 23.66 9.99 24.0 7.22Z"/>
                  <path d="M39.5 4.7C40.02 8.93 42.23 11.42 46.0 12.0C42.23 12.58 40.02 15.07 39.5 19.3C38.98 15.07 36.77 12.58 33.0 12.0C36.77 11.42 38.98 8.93 39.5 4.7Z"/>
                </g>
              </svg>
            )}
            {p.mark === "arc" && (
              <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M8 36 A 20 20 0 0 1 40 36"/>
              </svg>
            )}
            {p.mark === "curve" && (
              <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 30 Q 24 6, 42 30"/>
              </svg>
            )}
          </div>
          <h3 class="princ-title">{locale === "ar" ? p.title_ar : p.title_en}</h3>
          <p class="princ-body">{locale === "ar" ? p.body_ar : p.body_en}</p>
        </li>
      ))}
    </ul>

    <div class="about-foot">
      <a href={localePath(locale, "about")} class="btn-link">
        {locale === "ar" ? moreAr : moreEn}
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(44px, 5.5vw, 80px);
    background: var(--surface-subtle);
    border-block: 1px solid var(--border-subtle);
  }

  .about-head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 4vw, 3rem);
    max-width: 48ch;
  }
  .about-headline {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.14;
    color: var(--text-primary);
    text-wrap: pretty;
  }
  html[lang="ar"] .about-headline { letter-spacing: 0; line-height: 1.35; }

  .princ-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .princ-grid { grid-template-columns: 1fr 1fr; } }

  .princ {
    background: var(--surface-default);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .princ-mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--brand-primary);
    background: color-mix(in oklab, var(--brand-secondary) 36%, transparent);
    border-radius: 12px;
  }
  .princ-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.3;
  }
  html[lang="ar"] .princ-title { letter-spacing: 0; line-height: 1.5; font-size: 1.1875rem; }

  .princ-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 40ch;
    margin: 0;
  }
  html[lang="ar"] .princ-body { font-size: 1rem; line-height: 1.75; }

  .about-foot { margin-block-start: clamp(1.5rem, 3vw, 2rem); }
</style>
