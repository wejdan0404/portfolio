---
import { type Locale, localePath } from "../../lib/i18n";
import { strings, pick } from "../../lib/strings";

export interface Props { locale: Locale; }
const { locale } = Astro.props;

const principles = [
  {
    k: "01",
    en: "Research-grounded",
    ar: "مُستنِد إلى البحث",
    body: {
      en: "Every claim traces to a page citation; where evidence is missing, the page says so.",
      ar: "كلّ ادّعاء يُحال إلى صفحة بعينها؛ وحين تغيب الأدلّة تقول الصفحة ذلك.",
    },
  },
  {
    k: "02",
    en: "Arabic held to standard",
    ar: "العربية بالمستوى نفسه",
    body: {
      en: "RTL is load-bearing from the first component — not a theme switch, not a translation.",
      ar: "اليمين-إلى-اليسار محور العمل من أول مكوّن — ليس زِرَّ سمة، وليس ترجمة.",
    },
  },
  {
    k: "03",
    en: "Systems before screens",
    ar: "الأنظمة قبل الشاشات",
    body: {
      en: "Tokens, components, and type scales come first; screens are their predictable output.",
      ar: "الرموز والمكوّنات والسلالم الطباعية أولًا؛ والشاشات نتيجتها المتوقّعة.",
    },
  },
  {
    k: "04",
    en: "Decoration serves clarity",
    ar: "الزينة في خدمة الوضوح",
    body: {
      en: "When in doubt, cut the ornament before cutting the signal.",
      ar: "عند الشك، احذف الزخرفة قبل أن تحذف الإشارة.",
    },
  },
];
---

<section class="aboutstrip">
  <div class="container-wide">
    <div class="aboutstrip-grid">
      <div class="aboutstrip-lede">
        <span class="type-eyebrow">{pick(strings.home.aboutEyebrow, locale)}</span>
        <h2 class="type-display-m">{pick(strings.home.aboutHeading, locale)}</h2>
        <p class="type-body">{pick(strings.home.aboutBody, locale)}</p>
        <a href={localePath(locale, "about")} class="btn-link">
          {locale === "ar" ? "اقرئي المزيد عنّي" : "Read more about me"}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="mirror" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <ul class="principles" role="list">
        {principles.map((p) => (
          <li class="principle">
            <span class="p-k">{p.k}</span>
            <h3 class="p-title">{locale === "ar" ? p.ar : p.en}</h3>
            <p class="p-body">{pick(p.body, locale)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .aboutstrip { padding-block: clamp(4rem, 8vw, 6rem); }
  .aboutstrip-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 960px) {
    .aboutstrip-grid { grid-template-columns: 1fr 1.1fr; gap: 4rem; }
  }
  .aboutstrip-lede > * + * { margin-top: 1rem; }
  .aboutstrip-lede .btn-link { margin-top: 1.5rem; display: inline-flex; }

  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .principles { grid-template-columns: 1fr 1fr; }
  }
  .principle {
    padding: 1.25rem;
    border-radius: 14px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .p-k {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--brand-primary);
    font-weight: 600;
  }
  html[lang="ar"] .p-k { letter-spacing: 0; font-size: 0.85rem; }
  .p-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  html[lang="ar"] .p-title { letter-spacing: 0; }
  .p-body {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  html[lang="ar"] .p-body { font-size: 1rem; line-height: 1.75; }
</style>
